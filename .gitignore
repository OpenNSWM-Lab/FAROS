# .gitignore for FAROS project
# Generated to ignore virtualenvs, build artifacts, secrets, and common OS/IDE files

*.json
backend/data/
backend/tests/*
!backend/tests/test_faros_smoke.py
!backend/tests/test_paper_latex_safety.py
!backend/tests/test_paper_prompt_formatting.py
!backend/tests/test_release_smoke.py
!backend/tests/test_scientific_research_contracts.py
!backend/tests/test_research_dossier_schema.py
!backend/tests/test_idea_problem_framing.py
!backend/tests/test_idea_evidence_gate_contract.py
!backend/tests/test_idea_falsifiability.py
!backend/tests/fixtures/
!backend/tests/fixtures/scientific_research/
!backend/tests/fixtures/scientific_research/*.json
!backend/tests/fixtures/scientific_research/README.md

# Temp docs, backups, work logs
docs/
.worktrees/
*.bak
stop_dev.sh

# Python
__pycache__/
**/__pycache__/
**/__pycache__/**
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
!frontend/src/lib/types/
!frontend/src/lib/types/scientificResearch.ts
lib64/
parts/
sdist/
var/
*.egg-info/
*.egg
pip-wheel-metadata/
share/python-wheels/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
profile_default/
ipython_config.py
*.pyc
**/*.pyc

# Runtime / local data
/backend/data/provider_config.json
/.dev/
backend/.venv/
backend/data/**/__pycache__/
/backend/app/data/code_projects/

# LaTeX build artifacts (paper generation)
*.aux
*.bbl
*.blg
*.brf
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.nav
*.snm
*.vrb
latexmkrc
.latexmk/

# Node / frontend
node_modules/
/frontend/node_modules
/.pnp
.pnp.js
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files and secrets
.env
.env.*
backend/.env
frontend/.env

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
logs/

# Git metadata
*.orig

# Package artifacts
*.egg-info/
*.egg

# Misc
*.sqlite3
*.db
/.pytest_cache/

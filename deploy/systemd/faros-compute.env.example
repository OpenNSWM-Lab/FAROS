DATA_DIR=/opt/faros/runtime/data
FAROS_PROVIDER_CONFIG_DIR=/opt/faros/runtime/provider-configs
FAROS_SOURCE_REVISION=SET_TO_DEPLOYED_GIT_SHA
FAROS_EXECUTION_ROLE=compute
FAROS_EXECUTION_NODE_NAME=faros-compute-01
FAROS_EXECUTION_LOCATION=HUST-private-network
FAROS_ALLOW_HOST_EXECUTION=false
FAROS_ENABLE_HOST_CLAUDE_AGENT=false
FAROS_LLM_TRUST_ENV=false
FAROS_LLM_FORCE_IPV4=true
FAROS_LLM_MAX_INFLIGHT=2
FAROS_QWEN_ENABLE_THINKING=false
FAROS_REVIEWX_AUTH_MODE=proxy
FAROS_REVIEWX_SIGNER_USERS=faros-signer
FAROS_REVIEWER_USERS=faros-signer
FAROS_PDF_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
SANDBOX_DEFAULT_BACKEND=docker
SANDBOX_DOCKER_IMAGE=faros/codegen-test:3.12
SANDBOX_GPU_IMAGE=faros/codegen-gpu:cuda12.4
SANDBOX_MAX_CONCURRENT=2
SANDBOX_TTL_SEC=3600
SANDBOX_PIDS_LIMIT=256
FAROS_PROFILE_LIGHT_CPUS=2
FAROS_PROFILE_LIGHT_MEMORY=2g
FAROS_PROFILE_LIGHT_TIMEOUT=600
FAROS_PROFILE_STANDARD_CPUS=8
FAROS_PROFILE_STANDARD_MEMORY=16g
FAROS_PROFILE_STANDARD_TIMEOUT=1800
FAROS_PROFILE_GPU_CPUS=8
FAROS_PROFILE_GPU_MEMORY=24g
FAROS_PROFILE_GPU_TIMEOUT=3600
FAROS_GPU_MIN_FREE_MIB=8192
FAROS_GPU_MAX_UTILIZATION=80
OMP_NUM_THREADS=8
OPENBLAS_NUM_THREADS=8
MKL_NUM_THREADS=8
MPLCONFIGDIR=/opt/faros/runtime/matplotlib
PYTHONUNBUFFERED=1

# Keep the real file outside Git and set mode 0600.
# Generate a key with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FAROS_CREDENTIAL_KEY=REPLACE_WITH_A_FERNET_KEY

# Environment credentials are visible only to this authenticated FAROS user.
# The recommended judge workflow is to leave QWEN_API_KEY empty and let each
# account configure its own key in Settings / LLM Providers.
FAROS_ENV_PROVIDER_OWNER=faros-team
ACTIVE_PROVIDER_NAME=qwen
ACTIVE_MODEL_NAME=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# Optional literature-provider credentials and contact addresses.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=
CORE_API_KEY=
CNKI_API_KEY=
WANFANG_API_KEY=

# Optional authenticated bundle ingestion. Leave disabled unless another node
# must upload code/research bundles directly to this backend.
FAROS_BUNDLE_UPLOAD_TOKEN=
